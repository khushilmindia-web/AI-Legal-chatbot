OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
MAX_FILE_SIZE_MB=10
DEBUG=true
DEFAULT_STATE=Gujarat
RETRIEVAL_MODE=local_context
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# Keep sqlite until the MongoDB migration has been verified.
DATABASE_BACKEND=sqlite
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lawyer_ai
# For Google OAuth on mobile/LAN testing, set these to the exact public origin
# you open in the browser, for example: http://192.168.x.xx:5000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://192.168.x.xx:5000
GOOGLE_REDIRECT_URI=http://192.168.x.xx:5000/auth/google/callback
APP_BASE_URL=http://192.168.x.xx:5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Lawyer AI
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
INDIANKANOON_API_BASE_URL=https://api.indiankanoon.org
INDIANKANOON_API_TOKEN=******
INDIANKANOON_TIMEOUT_SECONDS=60
INDIANKANOON_TRUST_ENV_PROXY=false
API_CUSTOMER_ID=your-email@example.com
API_PRIVATE_KEY_PATH=secrets/api_private_key.pem
API_PUBLIC_KEY_PATH=secrets/api_public_key.pem
OPENAI_VECTOR_STORE_ID=******
