OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
MAX_FILE_SIZE_MB=10
DEBUG=false
DEFAULT_STATE=Gujarat
RETRIEVAL_MODE=local_context
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# SQLite temporarily disabled during MongoDB migration.
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lawyer_ai

# Public app origin used for redirects, CORS, reset links, and OAuth callbacks.
APP_BASE_URL=http://127.0.0.1:5000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
AUTH_COOKIE_NAME=session_token
AUTH_SESSION_DURATION_DAYS=14
FRONTEND_AUTH_PATH=/frontend/auth.html
FRONTEND_APP_PATH=/frontend/index.html

# Optional Google OAuth. For ngrok or production, use the exact HTTPS public origin opened in the browser.
# The app builds the effective redirect URI as: ${APP_BASE_URL}/auth/google/callback
# Add that exact value to Google Console Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Lawyer AI
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
INDIANKANOON_API_BASE_URL=https://api.indiankanoon.org
INDIANKANOON_API_TOKEN=your_indiankanoon_token_here
INDIANKANOON_TIMEOUT_SECONDS=60
INDIANKANOON_TRUST_ENV_PROXY=false
GOOGLE_SEARCH_ENABLED=false
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
GOOGLE_SEARCH_TIMEOUT_SECONDS=8
GOOGLE_SEARCH_MAX_RESULTS=3
GOOGLE_SEARCH_CACHE_TTL_SECONDS=21600
GOOGLE_SEARCH_TRUSTED_DOMAINS=gov.in,nic.in,rbi.org.in,cybercrime.gov.in,sci.gov.in
API_CUSTOMER_ID=your-email@example.com
API_PRIVATE_KEY_PATH=secrets/api_private_key.pem
API_PUBLIC_KEY_PATH=secrets/api_public_key.pem
OPENAI_VECTOR_STORE_ID=
